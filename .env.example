BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Supabase PostgreSQL connection string with verified TLS. Add the downloaded
# Supabase root CA path as sslrootcert, e.g. sslmode=verify-full&sslrootcert=./.secrets/prod-ca-2021.crt
DATABASE_URL=
# For Vercel: paste the complete Supabase root CA PEM as a server-only variable.
# Locally, use sslrootcert=./.secrets/prod-ca-2021.crt in DATABASE_URL instead.
DATABASE_SSL_CA=

# Optional local synthetic demo account seed values. Keep the password only in .env.local.
DEMO_ACCOUNT_NAME=Demo Citizen
DEMO_ACCOUNT_EMAIL=demo@example.test
DEMO_ACCOUNT_PASSWORD=

# Supabase private Storage — server-only; use the Secret key from Settings > API Keys
SUPABASE_URL=
# Preferred current API key. Legacy service_role JWT is supported under SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=certificate-files

# Local synthetic issuer only
ISSUER_TEST_KEY_ID=demo-school-key-v1
# Optional for hosted deployment; PEM values are server-only. Local key-file paths are used otherwise.
ISSUER_TEST_PRIVATE_KEY=
ISSUER_TRUSTED_PUBLIC_KEY=
ISSUER_TEST_PRIVATE_KEY_PATH=./.secrets/issuer-test-private.pem
ISSUER_TRUSTED_PUBLIC_KEY_PATH=./.secrets/issuer-test-public.pem
ISSUER_SIMULATED_FAILURE_MODE=none

